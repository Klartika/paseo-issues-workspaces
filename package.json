{
  "name": "paseo-issues-workspaces",
  "version": "0.1.0",
  "description": "Paseo plugin: browse a project's open GitHub issues and create a worktree workspace for one, optionally with an agent working on it.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "github",
    "issues",
    "worktree"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajma/paseo-issues-workspaces.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!client/test-host.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "jsdom": "^30.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.4.3"
  },
  "type": "module"
}
